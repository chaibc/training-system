# 翰墨学堂生产环境变量
# 复制到 /etc/hanmo/hanmo.env 后修改，权限必须是 640，属主 root:hanmo（备份脚本以 hanmo 用户读取）
# 注意：值中不要带未转义的 #；密码含特殊字符时用单引号包起来（不要有空格）

TZ=Asia/Shanghai

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hanmo_calligraphy
DB_USER=hanmo
DB_PASSWORD=请替换为强密码

# ---------- JWT ----------
# 生成：openssl rand -base64 48
JWT_SECRET=请替换为至少48字节随机字符串

# ---------- 上传目录 ----------
UPLOAD_DIR=/data/hanmo/uploads

# ---------- 管理端跨域 ----------
# 生产建议前后端同域，仅保留自己的域名
CORS_ORIGINS=https://hanmo.example.com

# ---------- 微信小程序 ----------
# 微信公众平台 → 开发管理 → 开发设置
WX_APP_ID=请替换为小程序AppID
WX_APP_SECRET=请替换为小程序AppSecret
# 生产必须为 false
WX_DEV_MODE=false
