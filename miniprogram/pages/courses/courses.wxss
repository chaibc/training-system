.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 26rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, .8);
  border: 1rpx solid var(--line);
}
.search-icon { color: var(--muted); font-size: 30rpx; }
.search-box input { flex: 1; font-size: 23rpx; }
.clear { color: var(--muted); font-size: 32rpx; padding: 0 4rpx; }
.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 26rpx;
  padding-bottom: 18rpx;
}
.course-card { overflow: hidden; }
.course-cover {
  height: 230rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 110rpx;
  color: rgba(255, 253, 248, .9);
}
.course-cover::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(300rpx 150rpx at 80% 10%, rgba(255, 255, 255, .18), transparent 70%);
}
.cover-tags { position: absolute; left: 22rpx; bottom: 18rpx; z-index: 1; }
.course-content { padding: 24rpx 26rpx 26rpx; }
.course-name { font-size: 32rpx; font-weight: 600; letter-spacing: 1rpx; }
.course-meta { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; }
.course-desc {
  color: var(--ink2);
  font-size: 21rpx;
  line-height: 1.7;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.course-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.course-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line2);
}
.course-foot .price { color: var(--red); font-size: 34rpx; font-weight: 700; }
.course-foot .unit { color: var(--muted); font-size: 19rpx; }
