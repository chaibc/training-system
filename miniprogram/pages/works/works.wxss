.work-art .work-type {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(35, 32, 25, .62);
  color: #F8F3E9;
  font-size: 17rpx;
}

.notice-list { margin: 0 32rpx 18rpx; border-radius: 18rpx; background: rgba(194,160,94,.08); border: 1rpx solid rgba(194,160,94,.16); overflow: hidden; }
.notice-item { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 18rpx; border-bottom: 1rpx solid rgba(194,160,94,.12); }
.notice-item:last-child { border-bottom: none; }
.notice-title { flex: 1; font-size: 21rpx; color: #6F5A32; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.notice-date { font-size: 17rpx; color: var(--muted); }
