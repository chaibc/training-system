/* ===== 课时总览卡：深墨底 + 鎏金数字 ===== */
.hours-hero {
  border-radius: 30rpx;
  padding: 34rpx 30rpx 28rpx;
  background: linear-gradient(118deg, #26221B 0%, #3A342A 58%, #4B3B2F 100%);
  color: #F8F2E6;
  position: relative;
  overflow: hidden;
}
.hh-label { color: #BFB6A5; font-size: 21rpx; letter-spacing: 1rpx; }
.hh-value { display: flex; align-items: baseline; gap: 10rpx; margin-top: 8rpx; }
.hh-value .n { font-family: Georgia, serif; font-size: 108rpx; line-height: 1.05; color: #E8C98E; }
.hh-value .u { color: #BFB6A5; font-size: 22rpx; }
.hh-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
  position: relative;
  z-index: 1;
}
.hh-grid > view { flex: 1; background: rgba(246, 241, 231, .07); border-radius: 16rpx; padding: 14rpx 12rpx; }
.hh-grid .v { display: block; font-family: Georgia, serif; font-size: 27rpx; color: #F2EDE3; }
.hh-grid .k { display: block; color: #BFB6A5; font-size: 17rpx; margin-top: 3rpx; }
.hh-watermark {
  position: absolute;
  right: -20rpx;
  bottom: -80rpx;
  font-family: "Songti SC", serif;
  font-size: 250rpx;
  color: rgba(246, 241, 231, .06);
  line-height: 1;
}
/* ===== 余额偏低提醒 ===== */
.renew-warning {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(194, 160, 94, .12);
  border: 1rpx solid rgba(194, 160, 94, .22);
  color: #6F5A32;
}
.rw-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(169, 120, 42, .6);
  color: var(--gold2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Georgia, serif;
  font-size: 24rpx;
  flex: none;
}
/* ===== 课时流水 ===== */
.ledger-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line2);
}
.ledger-item:last-child { border-bottom: none; }
.ledger-item .li-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 24rpx;
  flex: none;
}
.ledger-item .li-icon.in { background: rgba(92, 122, 99, .12); color: #45644D; }
.ledger-item .li-icon.out { background: rgba(180, 71, 60, .09); color: var(--red); }
.li-title { font-size: 24rpx; }
.li-change { font-family: Georgia, serif; font-size: 28rpx; font-weight: 600; }
.li-change.positive { color: #45644D; }
.li-change.negative { color: var(--red); }
.li-time { color: var(--muted); font-size: 18rpx; }
.li-balance { color: var(--muted); font-size: 18rpx; }
