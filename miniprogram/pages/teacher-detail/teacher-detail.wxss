/* ===== 教师头部 ===== */
.td-hero {
  min-height: 360rpx;
  padding: 44rpx 32rpx;
  background: linear-gradient(118deg, #26221B 0%, #3A342A 58%, #4B3B2F 100%);
  color: #F8F2E6;
  position: relative;
  overflow: hidden;
}
.td-name { font-size: 46rpx; letter-spacing: 3rpx; margin-top: 20rpx; }
.td-meta { color: #BFB6A5; font-size: 21rpx; margin-top: 8rpx; }
.td-tags { display: flex; gap: 10rpx; margin-top: 16rpx; }
.td-watermark {
  position: absolute;
  right: -20rpx;
  bottom: -80rpx;
  font-family: "Songti SC", serif;
  font-size: 270rpx;
  color: rgba(246, 241, 231, .06);
  line-height: 1;
}
/* ===== 教学理念引言卡 ===== */
.quote-card {
  position: relative;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(194, 160, 94, .09);
  border: 1rpx solid rgba(194, 160, 94, .18);
  overflow: hidden;
}
.q-mark {
  position: absolute;
  right: 18rpx;
  top: -40rpx;
  font-family: Georgia, serif;
  font-size: 170rpx;
  color: rgba(169, 120, 42, .12);
}
/* ===== 引言正文（宋体 + 深金色） ===== */
.q-text { font-family: "Songti SC", serif; color: #6F5A32; font-size: 26rpx; line-height: 1.9; position: relative; }
.q-by { color: var(--muted); font-size: 20rpx; text-align: right; margin-top: 12rpx; }
/* ===== 教学履历正文 ===== */
.about-text { color: var(--ink2); font-size: 23rpx; line-height: 1.9; }
