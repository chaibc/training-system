<view class="page">
  <view class="page-head">
    <view class="eyebrow">OUR TEACHERS</view>
    <view class="h1">师资团队</view>
    <view class="sub">教龄、擅长书体与教学特点均来自教师档案。小班教学，逐字点评。</view>
  </view>

  <!-- 教师列表 -->
  <view class="stack pad" style="margin-top:24rpx">
    <view wx:for="{{teachers}}" wx:key="id" class="teacher-card card" bindtap="goTeacher" data-id="{{item.id}}">
      <view class="avatar" style="background:{{index % 2 === 0 ? '#6B503A' : '#4C6455'}}">{{item.avatarChar}}</view>
      <view class="flex1" style="min-width:0">
        <view class="between">
          <view class="name">{{item.name}}</view>
          <text class="tag gold">{{item.years}} 年教龄</text>
        </view>
        <view class="meta">{{item.title}} · {{item.styleText}}</view>
        <view class="quote-line">{{item.bio}}</view>
        <view class="t-tags">
          <text wx:for="{{item.tagsList}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>
      </view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{!teachers.length && !loading}}" class="empty"><view class="seal">师</view>师资信息整理中</view>
  </view>

  <!-- 试听引导 -->
  <view class="teach-note">
    <view class="tn-art">教</view>
    <view class="flex1">
      <view class="serif" style="font-size:28rpx;font-weight:600">不确定孩子适合哪位老师？</view>
      <view class="muted small" style="margin-top:6rpx;line-height:1.7">先预约一次试听，教务会根据年龄、基础与时间安排合适的班级与教师。</view>
    </view>
  </view>
  <view class="pad">
    <button class="btn primary block" bindtap="goTrial">预约试听</button>
  </view>

  <!-- 页脚说明 -->
  <view class="foot-note">教师账号由机构后台创建
所有教师均按所带班级与学员范围查看教学数据</view>
</view>
