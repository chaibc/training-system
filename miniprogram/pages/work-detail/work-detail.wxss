.work-hero { background: #EFE7D8; }
.wh-stamp {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  width: 62rpx;
  height: 62rpx;
  border: 1rpx solid rgba(180, 71, 60, .55);
  color: rgba(180, 71, 60, .8);
  font-family: "Songti SC", serif;
  font-size: 17rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  white-space: pre-line;
}
.wd-title { font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx; }
.wd-meta { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; }
.teacher-comment { position: relative; }
.tc-label {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(194, 160, 94, .18);
  color: #7C5A20;
  font-size: 19rpx;
}
.tc-text { color: var(--ink2); font-size: 23rpx; line-height: 1.9; margin-top: 14rpx; }
.tc-by { color: var(--muted); font-size: 20rpx; text-align: right; margin-top: 10rpx; }
.authorize-note {
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.7;
  padding: 18rpx 4rpx;
}
.interact-row {
  display: flex;
  gap: 14rpx;
  padding: 10rpx 0 4rpx;
}
.interact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, .8);
  border: 1rpx solid var(--line);
  color: var(--ink2);
  font-size: 21rpx;
}
.interact.on { color: var(--red); border-color: rgba(180, 71, 60, .35); background: rgba(180, 71, 60, .06); }
.interact .ii { font-size: 26rpx; }
.comment { padding: 18rpx 0; border-bottom: 1rpx solid var(--line2); }
.comment:last-of-type { border-bottom: none; }
.comment-head { display: flex; align-items: center; gap: 14rpx; }
.c-name { font-size: 22rpx; font-weight: 500; }
.c-time { color: var(--muted); font-size: 17rpx; margin-top: 2rpx; }
.c-text { color: var(--ink2); font-size: 22rpx; line-height: 1.75; margin-top: 12rpx; padding-left: 70rpx; }
.comment-login {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
}
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, .97);
  border-top: 1rpx solid var(--line);
}
.comment-bar input {
  flex: 1;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--paper2);
  font-size: 22rpx;
}
