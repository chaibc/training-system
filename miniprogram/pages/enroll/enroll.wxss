/* ===== 学员选择标签 ===== */
.child-chip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: none;
  padding: 14rpx 20rpx 14rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 253, 248, .75);
}
.child-chip.on { border-color: var(--red); background: rgba(180, 71, 60, .06); }
.cc-name { font-size: 24rpx; font-weight: 600; }
.cc-meta { color: var(--muted); font-size: 18rpx; }
/* ===== 课程选项 ===== */
.course-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid transparent;
}
.course-option.sel { border-color: rgba(180, 71, 60, .45); background: rgba(255, 253, 248, .95); }
.co-name { font-size: 26rpx; font-weight: 600; }
.co-meta { color: var(--muted); font-size: 19rpx; margin-top: 4rpx; }
.co-price { color: var(--red); font-size: 24rpx; font-weight: 600; margin-top: 6rpx; }
/* ===== 单选圆点 ===== */
.radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 1rpx solid #C9BFAE;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.radio.on { background: var(--red); border-color: var(--red); }
/* ===== 班级选项与确认摘要 ===== */
.class-option { padding: 22rpx; border: 1rpx solid transparent; }
.class-option.sel { border-color: rgba(180, 71, 60, .45); background: rgba(255, 253, 248, .95); }
.summary-card { background: rgba(255, 253, 248, .8); }
