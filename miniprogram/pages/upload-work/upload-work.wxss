.uploader {
  position: relative;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F9F5EC;
  border: 1rpx dashed #CFC5B4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.uploader image { width: 100%; height: 100%; }
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: var(--muted);
}
.up-plus { font-size: 56rpx; color: var(--gold2); line-height: 1; }
.up-text { font-size: 23rpx; color: var(--ink2); }
.up-tip { font-size: 18rpx; }
.reupload {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(35, 32, 25, .65);
  color: #F8F3E9;
  font-size: 18rpx;
}
.picker { display: flex; align-items: center; }
.no-auth { padding: 18rpx; border-radius: 14rpx; background: #F9F5EC; color: var(--muted); font-size: 21rpx; }
.auth-warning {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(180, 71, 60, .06);
  color: var(--red2);
  font-size: 19rpx;
  line-height: 1.7;
}
.aw-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(180, 71, 60, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-family: Georgia, serif;
  font-size: 18rpx;
  margin-top: 2rpx;
}
.my-work {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line2);
}
.my-work:last-child { border-bottom: none; }
