/* ===== 学员信息条 ===== */
.growth-head { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 26rpx; }
/* ===== 月度时间线 ===== */
.growth-month { margin-bottom: 34rpx; }
.gm-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.gm-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--red);
  flex: none;
}
.gm-month { font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx; flex: none; }
.gm-line { flex: 1; height: 1rpx; background: var(--line); }
.gm-works { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.gm-work {
  background: var(--card);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(35, 32, 25, .055);
}
.gm-work .work-art { height: 230rpx; }
.gm-work-title { padding: 14rpx 16rpx 2rpx; font-family: "Songti SC", serif; font-size: 24rpx; font-weight: 600; }
.gm-work-meta { padding: 0 16rpx 16rpx; color: var(--muted); font-size: 18rpx; }
/* ===== 教师点评（鎏金左边线） ===== */
.gm-comment {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(194, 160, 94, .09);
  border-left: 4rpx solid var(--gold);
  color: #6F5A32;
  font-size: 21rpx;
  line-height: 1.8;
  position: relative;
}
.gm-quote {
  font-family: Georgia, serif;
  font-size: 42rpx;
  color: rgba(169, 120, 42, .3);
  line-height: 1;
  margin-right: 4rpx;
}
