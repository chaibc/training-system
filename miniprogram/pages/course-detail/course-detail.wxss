.cd-hero {
  height: 370rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cd-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(400rpx 220rpx at 80% 10%, rgba(255, 255, 255, .18), transparent 70%);
}
.cd-stamp {
  position: absolute;
  right: 32rpx;
  top: 30rpx;
  width: 74rpx;
  height: 74rpx;
  border: 1rpx solid rgba(194, 160, 94, .5);
  color: var(--gold);
  font-family: "Songti SC", serif;
  font-size: 20rpx;
  line-height: 1.25;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  transform: rotate(4deg);
  z-index: 1;
  white-space: pre-line;
}
.cd-eyebrow {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  color: rgba(248, 242, 230, .72);
  font-size: 19rpx;
  letter-spacing: 3rpx;
  z-index: 1;
}
.cd-char {
  font-family: "Songti SC", serif;
  font-size: 190rpx;
  color: rgba(255, 253, 248, .94);
  text-shadow: 0 10rpx 40rpx rgba(0, 0, 0, .18);
  z-index: 1;
}
.cd-watermark {
  position: absolute;
  right: -20rpx;
  bottom: -70rpx;
  font-family: "Songti SC", serif;
  font-size: 240rpx;
  color: rgba(255, 253, 248, .06);
  line-height: 1;
}
.cd-head { padding-top: 32rpx; }
.cd-name { font-size: 44rpx; letter-spacing: 2rpx; font-weight: 600; }
.cd-sub { color: var(--ink2); font-size: 23rpx; line-height: 1.8; margin-top: 14rpx; }
.cd-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.metric-card {
  display: flex;
  margin-top: 26rpx;
  padding: 26rpx 10rpx;
}
.metric { flex: 1; text-align: center; border-right: 1rpx solid var(--line2); }
.metric:last-child { border-right: none; }
.metric .mv { font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 600; }
.metric .mk { color: var(--muted); font-size: 19rpx; margin-top: 6rpx; }
.goal-card { position: relative; overflow: hidden; }
.goal-mark {
  position: absolute;
  right: 16rpx;
  top: -40rpx;
  font-family: Georgia, serif;
  font-size: 190rpx;
  color: rgba(194, 160, 94, .12);
  line-height: 1;
}
.goal-text { color: var(--ink2); font-size: 23rpx; line-height: 1.9; position: relative; }
.price-list { overflow: hidden; }
.price-row {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line2);
}
.price-row:last-child { border-bottom: none; }
.pr-name { font-size: 26rpx; font-weight: 500; }
.pr-note { color: var(--muted); font-size: 18rpx; margin-top: 4rpx; }
.pr-amount { color: var(--red); font-family: Georgia, "Songti SC", serif; font-size: 38rpx; font-weight: 600; }
.pr-amount text { font-size: 19rpx; font-weight: 400; margin-left: 3rpx; }
