/* ===== 快捷入口 ===== */
.tools-grid { margin-top: 20rpx; }
/* ===== 待审批请假 ===== */
.leave-mini { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 24rpx; }
/* ===== 本周排课 ===== */
.week-list { overflow: hidden; }
.week-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--line2);
}
.week-row:last-child { border-bottom: none; }
.wr-day { width: 150rpx; color: var(--muted); font-size: 19rpx; flex: none; }
.workbench .stamp { white-space: pre-line; line-height: 1.2; }
