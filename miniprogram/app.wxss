/* 翰墨学堂 · 全局视觉系统
   纸色底 / 墨色字 / 朱砂红 / 描金，配合宋体标题 */
page {
  --ink: #232019;
  --ink2: #5F594E;
  --muted: #948C7C;
  --paper: #F6F1E7;
  --paper2: #EFE8DA;
  --card: #FFFDF8;
  --line: #E7DFD0;
  --line2: #F0E9DC;
  --red: #B4473C;
  --red2: #93352C;
  --gold: #C2A05E;
  --gold2: #A9782A;
  --jade: #5C7A63;
  --blue: #2E6A9E;
  background: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 27rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view, swiper, image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  text-align: left;
}

button::after {
  border: none;
}

input, textarea {
  font-family: inherit;
  color: var(--ink);
}

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: var(--paper);
}

.pad {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.page-head {
  padding: 26rpx 32rpx 4rpx;
}

.page-head .eyebrow {
  color: var(--red);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.page-head .h1 {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.35;
}

.page-head .sub {
  margin-top: 10rpx;
  color: var(--ink2);
  font-size: 23rpx;
  line-height: 1.75;
}

.serif {
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.muted { color: var(--muted); }
.small { font-size: 22rpx; }
.tiny { font-size: 19rpx; }
.red { color: var(--red); }
.gold { color: var(--gold2); }
.jade { color: var(--jade); }
.bold { font-weight: 600; }
.num { font-variant-numeric: tabular-nums; }
.center { text-align: center; }
.flex1 { flex: 1; }
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.wrap { flex-wrap: wrap; }
.gap8 { gap: 16rpx; }
.gap12 { gap: 24rpx; }
.mt8 { margin-top: 16rpx; }
.mt12 { margin-top: 24rpx; }
.mt16 { margin-top: 32rpx; }
.mt24 { margin-top: 48rpx; }
.mb12 { margin-bottom: 24rpx; }
.hr { height: 1rpx; background: var(--line2); margin: 24rpx 0; }

.card {
  background: var(--card);
  border: 1rpx solid rgba(35, 32, 25, .055);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(35, 32, 25, .035);
}

.card.padc { padding: 28rpx; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.stack-sm { display: flex; flex-direction: column; gap: 12rpx; }

.section {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 38rpx 32rpx 20rpx;
}

.section .title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section .title::before {
  content: "";
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--red);
}

.section .more {
  font-size: 21rpx;
  color: var(--muted);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  background: var(--paper2);
  color: var(--ink2);
  white-space: nowrap;
  line-height: 1.5;
}

.tag.red { background: rgba(180, 71, 60, .09); color: var(--red); }
.tag.green { background: rgba(92, 122, 99, .11); color: #45644D; }
.tag.gold { background: rgba(194, 160, 94, .17); color: #7C5A20; }
.tag.blue { background: rgba(46, 106, 158, .09); color: var(--blue); }
.tag.dark { background: rgba(35, 32, 25, .82); color: #F7F2E8; }
.tag.line { background: transparent; border: 1rpx solid var(--line); }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  padding: 22rpx 32rpx;
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity .15s;
}

.btn:active { opacity: .82; }
.btn.primary { background: var(--red); color: #fff; box-shadow: 0 8rpx 22rpx rgba(180, 71, 60, .22); }
.btn.dark { background: var(--ink); color: #F8F3E9; }
.btn.ghost { background: transparent; border: 1rpx solid rgba(35, 32, 25, .18); color: var(--ink); }
.btn.soft { background: var(--paper2); color: var(--ink); }
.btn.gold { background: var(--gold); color: #2E291F; }
.btn.block { width: 100%; }
.btn.sm { padding: 12rpx 22rpx; font-size: 22rpx; font-weight: 500; }
.btn.disabled { opacity: .45; pointer-events: none; }
.btn-row { display: flex; gap: 16rpx; }
.btn-row .btn { flex: 1; }

.textlink {
  color: var(--red);
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
}

/* 头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  flex: none;
}

.avatar.lg { width: 104rpx; height: 104rpx; border-radius: 28rpx; font-size: 46rpx; }
.avatar.sm { width: 56rpx; height: 56rpx; border-radius: 16rpx; font-size: 25rpx; }

/* 空状态 */
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--muted);
  font-size: 23rpx;
}

.empty .seal {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  color: var(--muted);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-3deg);
}

/* 表单 */
.field { margin-bottom: 24rpx; }
.field .label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--ink2);
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.field .label .req { color: var(--red); }
.field input, .field textarea, .field .picker {
  width: 100%;
  background: #F9F5EC;
  border: 1rpx solid rgba(35, 32, 25, .07);
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  min-height: 82rpx;
}
.field textarea { min-height: 150rpx; resize: none; }
.field .picker { display: flex; align-items: center; color: var(--ink); }
.field .placeholder { color: #B5AD9D; }
.field-row { display: flex; gap: 20rpx; }
.field-row .field { flex: 1; }
.check {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.7;
  margin: 18rpx 0;
}
.check .box {
  width: 28rpx;
  height: 28rpx;
  border: 1rpx solid #C9BFAE;
  border-radius: 8rpx;
  flex: none;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
}
.check .box.on { background: var(--red); border-color: var(--red); }
.check b { color: var(--ink2); font-weight: 500; }

.form-tip {
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(194, 160, 94, .11);
  border: 1rpx solid rgba(194, 160, 94, .2);
  color: #6F5A32;
  font-size: 20rpx;
  line-height: 1.75;
  margin-bottom: 24rpx;
}

.form-actions { padding: 24rpx 32rpx 50rpx; }

/* 筛选 */
.chips {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 0 32rpx 8rpx;
}
.chips::-webkit-scrollbar { display: none; }
.chip {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: rgba(255, 253, 248, .7);
  color: var(--ink2);
  font-size: 22rpx;
  flex: none;
}
.chip.on { background: var(--ink); border-color: var(--ink); color: #F8F3E9; }
.chip.red.on { background: var(--red); border-color: var(--red); }

.seg {
  display: flex;
  gap: 6rpx;
  background: var(--paper2);
  border-radius: 18rpx;
  padding: 6rpx;
}
.seg .s {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: var(--ink2);
}
.seg .s.on {
  background: var(--card);
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(35, 32, 25, .08);
}

/* 首页 */
.home-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 32rpx 24rpx;
}
.home-top .seal {
  width: 74rpx;
  height: 74rpx;
  border-radius: 10rpx;
  background: var(--red);
  color: #fff;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(180, 71, 60, .22);
}
.home-top .name { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 36rpx; letter-spacing: 4rpx; line-height: 1.2; }
.home-top .slogan { color: var(--muted); font-size: 18rpx; letter-spacing: 2rpx; margin-top: 6rpx; }

.hero {
  position: relative;
  margin: 0 28rpx;
  border-radius: 34rpx;
  padding: 42rpx 34rpx 38rpx;
  background: linear-gradient(118deg, #26221B 0%, #3A342A 58%, #4B3B2F 100%);
  color: #F8F2E6;
  overflow: hidden;
  box-shadow: 0 20rpx 42rpx rgba(35, 32, 25, .2);
}
.hero .watermark {
  position: absolute;
  right: 4rpx;
  bottom: -64rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 240rpx;
  line-height: 1;
  color: rgba(246, 241, 231, .07);
}
.hero .stamp {
  position: absolute;
  right: 30rpx;
  top: 28rpx;
  width: 70rpx;
  height: 70rpx;
  border: 1rpx solid rgba(194, 160, 94, .45);
  color: var(--gold);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 20rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  transform: rotate(4deg);
}
.hero .eyebrow { color: var(--gold); font-size: 17rpx; letter-spacing: 5rpx; margin-bottom: 18rpx; position: relative; }
.hero .h2 { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 45rpx; line-height: 1.4; letter-spacing: 3rpx; position: relative; }
.hero .h2 .em { color: #E8C98E; }
.hero .desc { color: #BFB6A5; font-size: 20rpx; line-height: 1.75; margin-top: 16rpx; max-width: 420rpx; position: relative; }
.hero-actions { display: flex; gap: 16rpx; margin-top: 32rpx; position: relative; }
.hero-actions .btn { padding: 16rpx 28rpx; font-size: 22rpx; }

.quick-grid {
  margin: -2rpx 28rpx 0;
  background: var(--card);
  border: 1rpx solid rgba(35, 32, 25, .055);
  border-top: none;
  border-radius: 0 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 26rpx 10rpx 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 32, 25, .05);
}
.quick-grid .q {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: var(--ink2);
}
.quick-grid .qi {
  width: 74rpx;
  height: 74rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper2);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx;
}
.quick-grid .q:nth-child(1) .qi { background: rgba(180, 71, 60, .09); color: var(--red); }
.quick-grid .q:nth-child(2) .qi { background: rgba(194, 160, 94, .14); color: var(--gold2); }
.quick-grid .q:nth-child(3) .qi { background: rgba(92, 122, 99, .1); color: var(--jade); }
.quick-grid .q:nth-child(4) .qi { background: rgba(46, 106, 158, .08); color: var(--blue); }

.notice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 24rpx 28rpx 0;
  padding: 18rpx 22rpx;
  background: rgba(194, 160, 94, .1);
  border: 1rpx solid rgba(194, 160, 94, .16);
  border-radius: 16rpx;
  font-size: 21rpx;
  color: #6F5A32;
}
.notice-bar .n { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.course-mini {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}
.course-cover {
  width: 150rpx;
  height: 150rpx;
  border-radius: 24rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 253, 248, .92);
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 62rpx;
  background: linear-gradient(145deg, #75422F, #A05B40);
  position: relative;
  overflow: hidden;
}
.course-cover.small { width: 112rpx; height: 112rpx; border-radius: 20rpx; font-size: 48rpx; }
.course-cover.large { width: 100%; height: 330rpx; border-radius: 0; font-size: 150rpx; }
.course-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.course-body .name { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
.course-body .meta { color: var(--muted); font-size: 20rpx; margin-top: 8rpx; }
.course-body .price { color: var(--red); font-weight: 700; font-size: 26rpx; margin-top: 14rpx; }
.course-body .price .unit { color: var(--muted); font-size: 18rpx; font-weight: 400; }

/* 列表 */
.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line2);
}
.list-item:last-child { border-bottom: none; }
.list-item .li-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: var(--paper2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  color: var(--ink2);
  flex: none;
}
.list-item .li-body { flex: 1; min-width: 0; }
.list-item .li-title { font-size: 27rpx; font-weight: 500; }
.list-item .li-sub { color: var(--muted); font-size: 20rpx; margin-top: 5rpx; }
.list-item .arrow { color: #C0B7A7; font-size: 26rpx; }

/* 课表 */
.week-strip {
  display: flex;
  gap: 8rpx;
  padding: 0 24rpx 16rpx;
}
.week-day {
  flex: 1;
  text-align: center;
  padding: 16rpx 2rpx;
  border-radius: 18rpx;
}
.week-day .w { color: var(--muted); font-size: 18rpx; }
.week-day .d { font-family: Georgia, serif; font-size: 30rpx; margin-top: 4rpx; }
.week-day.on { background: var(--ink); color: #F8F3E9; }
.week-day.on .w { color: rgba(248, 243, 233, .6); }
.week-day.today .d { color: var(--red); }
.week-day.on.today .d { color: #E8C98E; }

.lesson-card {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  position: relative;
}
.lesson-time {
  width: 104rpx;
  flex: none;
  border-right: 1rpx solid var(--line2);
  padding-right: 16rpx;
}
.lesson-time .t { font-family: Georgia, serif; font-size: 30rpx; color: var(--ink); }
.lesson-time .d { color: var(--muted); font-size: 18rpx; margin-top: 4rpx; }
.lesson-info { flex: 1; min-width: 0; }
.lesson-info .n { font-size: 27rpx; font-weight: 500; }
.lesson-info .m { color: var(--muted); font-size: 20rpx; margin-top: 5rpx; }
.lesson-side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 10rpx; }

/* 统计 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.stat {
  background: rgba(255, 253, 248, .68);
  border: 1rpx solid var(--line2);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}
.stat .v { font-family: Georgia, "Songti SC", serif; font-size: 40rpx; font-weight: 600; color: var(--ink); line-height: 1.2; }
.stat .v small { font-size: 18rpx; font-weight: 400; color: var(--muted); margin-left: 2rpx; }
.stat .k { color: var(--muted); font-size: 19rpx; margin-top: 6rpx; }

/* 时间线 */
.timeline { position: relative; padding-left: 34rpx; }
.timeline::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: var(--line);
}
.tl-item { position: relative; padding-bottom: 30rpx; }
.tl-item::before {
  content: "";
  position: absolute;
  left: -31rpx;
  top: 10rpx;
  width: 17rpx;
  height: 17rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 4rpx solid var(--gold);
}
.tl-item:last-child { padding-bottom: 0; }

/* 结果页 */
.result-page {
  min-height: 100vh;
  padding: 90rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-seal {
  width: 150rpx;
  height: 150rpx;
  border-radius: 36rpx;
  background: var(--red);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 62rpx;
  box-shadow: 0 20rpx 40rpx rgba(180, 71, 60, .24);
  transform: rotate(-3deg);
}
.result-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
  letter-spacing: 3rpx;
  margin-top: 38rpx;
  font-weight: 600;
}
.result-sub { color: var(--ink2); font-size: 23rpx; line-height: 1.8; margin-top: 14rpx; text-align: center; white-space: pre-line; }
.result-card { width: 100%; margin-top: 42rpx; padding: 28rpx; }
.result-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 12rpx 0; font-size: 23rpx; }
.result-row .k { color: var(--muted); }
.result-row .v { text-align: right; font-weight: 500; }
.result-flow { width: 100%; margin-top: 32rpx; display: flex; align-items: flex-start; }
.result-flow .step { flex: 1; text-align: center; position: relative; font-size: 19rpx; color: var(--muted); }
.result-flow .step .dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  background: var(--paper);
  margin: 0 auto 10rpx;
}
.result-flow .step.on { color: var(--ink); }
.result-flow .step.on .dot { border-color: var(--red); background: var(--red); }
.result-flow .step::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 11rpx;
  width: 100%;
  height: 2rpx;
  background: var(--line);
  z-index: 0;
}
.result-flow .step:last-child::after { display: none; }
.result-flow .step .dot { position: relative; z-index: 1; }
.result-actions { width: 100%; margin-top: 56rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* 底部操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, .96);
  border-top: 1rpx solid rgba(35, 32, 25, .07);
  backdrop-filter: blur(12px);
  display: flex;
  gap: 16rpx;
}
.bottom-bar .btn { flex: 1; }
.has-bottom-bar { padding-bottom: 160rpx; }

/* 游客提示 */
.guest-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 28rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(180, 71, 60, .07);
  border: 1rpx solid rgba(180, 71, 60, .12);
  font-size: 21rpx;
  color: var(--red2);
}
.guest-bar .link { margin-left: auto; font-weight: 600; white-space: nowrap; }

/* 登录页 */
.login-page {
  min-height: 100vh;
  background:
    radial-gradient(600rpx 500rpx at 85% 5%, rgba(194, 160, 94, .18), transparent 70%),
    radial-gradient(500rpx 400rpx at 0% 100%, rgba(180, 71, 60, .08), transparent 60%),
    var(--paper);
  padding: 90rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
}
.login-seal {
  width: 132rpx;
  height: 132rpx;
  border-radius: 20rpx;
  background: var(--red);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 64rpx;
  box-shadow: 0 18rpx 40rpx rgba(180, 71, 60, .28);
  transform: rotate(-3deg);
}
.login-title { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 54rpx; letter-spacing: 6rpx; margin-top: 40rpx; }
.login-desc { color: var(--ink2); font-size: 24rpx; line-height: 1.9; margin-top: 18rpx; white-space: pre-line; }
.login-card { margin-top: 52rpx; padding: 32rpx 28rpx; }
.login-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 36rpx; }
.login-note { color: var(--muted); font-size: 20rpx; line-height: 1.7; text-align: center; margin-top: 22rpx; }
.login-foot { margin-top: auto; text-align: center; color: var(--muted); font-size: 19rpx; line-height: 1.8; padding-top: 50rpx; white-space: pre-line; }

/* 工作台 */
.workbench {
  margin: 0 28rpx;
  border-radius: 32rpx;
  padding: 36rpx 30rpx;
  background: linear-gradient(118deg, #26221B 0%, #3A342A 60%, #4B3B2F 100%);
  color: #F8F2E6;
  position: relative;
  overflow: hidden;
}
.workbench .stamp {
  position: absolute;
  right: 26rpx;
  top: 26rpx;
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid rgba(194, 160, 94, .4);
  color: var(--gold);
  font-family: "Songti SC", serif;
  font-size: 19rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(4deg);
}
.workbench .hello { color: #BFB6A5; font-size: 20rpx; letter-spacing: 2rpx; }
.workbench .name { font-family: "Songti SC", serif; font-size: 42rpx; letter-spacing: 3rpx; margin-top: 10rpx; }
.workbench .meta { color: #BFB6A5; font-size: 20rpx; margin-top: 10rpx; }
.workbench .stats { display: flex; gap: 14rpx; margin-top: 28rpx; }
.workbench .ws { flex: 1; background: rgba(246, 241, 231, .08); border-radius: 16rpx; padding: 16rpx 10rpx; text-align: center; }
.workbench .ws .v { font-family: Georgia, serif; font-size: 34rpx; color: #E8C98E; }
.workbench .ws .k { color: #BFB6A5; font-size: 18rpx; margin-top: 2rpx; }

/* 工作台快捷入口 */
.tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin: 0 28rpx; }
.tool-card {
  background: var(--card);
  border: 1rpx solid rgba(35, 32, 25, .055);
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.tool-card .ti {
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background: var(--paper2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  color: var(--red);
  flex: none;
}
.tool-card .tt { font-size: 24rpx; font-weight: 500; }
.tool-card .ts { color: var(--muted); font-size: 18rpx; margin-top: 2rpx; }

/* 点名 */
.roll-student {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line2);
}
.roll-student:last-child { border-bottom: none; }
.roll-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background: #8A6A49;
  color: #fff;
  font-family: "Songti SC", serif;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.roll-actions { display: flex; gap: 8rpx; margin-left: auto; }
.roll-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: var(--paper2);
  color: var(--ink2);
  border: 1rpx solid transparent;
}
.roll-pill.on.present { background: var(--jade); color: #fff; }
.roll-pill.on.leave { background: var(--gold); color: #2E291F; }
.roll-pill.on.absent { background: var(--red); color: #fff; }
.roll-summary {
  display: flex;
  gap: 10rpx;
  padding: 20rpx 28rpx;
  background: rgba(255, 253, 248, .8);
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1rpx solid var(--line2);
}
.roll-summary .rs { flex: 1; text-align: center; }
.roll-summary .v { font-family: Georgia, serif; font-size: 34rpx; font-weight: 600; }
.roll-summary .k { color: var(--muted); font-size: 18rpx; }

/* 作品 */
.works-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; padding: 0 28rpx; }
.work-card {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(35, 32, 25, .055);
}
.work-art {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: linear-gradient(145deg, #F3EBDD, #EAE0CE);
  overflow: hidden;
}
.work-art .ch {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 130rpx;
  color: #332D23;
  opacity: .82;
  line-height: 1;
}
.work-art .stamp {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 36rpx;
  height: 36rpx;
  border: 1rpx solid rgba(180, 71, 60, .5);
  color: rgba(180, 71, 60, .8);
  font-size: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", serif;
}
.work-art image { width: 100%; height: 100%; }
.work-info { padding: 18rpx 20rpx 22rpx; }
.work-info .t { font-family: "Songti SC", serif; font-size: 26rpx; font-weight: 600; }
.work-info .m { color: var(--muted); font-size: 19rpx; margin-top: 4rpx; }
.work-info .b { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; color: var(--muted); font-size: 19rpx; }
.work-hero {
  height: 700rpx;
  background: linear-gradient(145deg, #F3EBDD, #EAE0CE);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.work-hero .ch { font-family: "Songti SC", serif; font-size: 260rpx; line-height: 1.2; color: #332D23; text-align: center; }
.work-hero image { width: 100%; height: 100%; }

/* 机构 */
.about-hero {
  margin: 0 28rpx;
  height: 300rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #2B261E, #4C3B2C);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  color: #F8F2E6;
}
.about-hero::before {
  content: "翰墨";
  position: absolute;
  right: -10rpx;
  top: -50rpx;
  font-family: "Songti SC", serif;
  font-size: 220rpx;
  color: rgba(246, 241, 231, .06);
  line-height: 1;
}
.about-hero .t { font-family: "Songti SC", serif; font-size: 40rpx; letter-spacing: 3rpx; position: relative; }
.about-hero .s { color: #CFC6B5; font-size: 21rpx; margin-top: 8rpx; position: relative; }

.teacher-card { display: flex; gap: 22rpx; padding: 26rpx; align-items: center; }
.teacher-card .avatar { width: 112rpx; height: 112rpx; border-radius: 28rpx; font-size: 46rpx; }
.teacher-card .name { font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 600; }
.teacher-card .meta { color: var(--muted); font-size: 20rpx; margin-top: 5rpx; }
.teacher-card .quote-line { color: var(--ink2); font-size: 20rpx; margin-top: 10rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* 详情行 */
.kv { display: flex; justify-content: space-between; gap: 24rpx; padding: 14rpx 0; font-size: 24rpx; }
.kv .k { color: var(--muted); flex: none; }
.kv .v { text-align: right; }

/* 课时数字 */
.big-hours { display: flex; align-items: baseline; gap: 6rpx; }
.big-hours .n { font-family: Georgia, "Songti SC", serif; font-size: 78rpx; font-weight: 600; line-height: 1; color: var(--red); }
.big-hours .u { color: var(--muted); font-size: 22rpx; }

/* 粘贴在底部的提示 */
.foot-note { text-align: center; color: var(--muted); font-size: 19rpx; line-height: 1.8; padding: 36rpx 48rpx 10rpx; white-space: pre-line; }

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 18, 14, .45);
  z-index: 90;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--card);
  border-radius: 36rpx 36rpx 0 0;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
}
.sheet .handle { width: 64rpx; height: 7rpx; border-radius: 4rpx; background: #DCD3C3; margin: 0 auto 24rpx; }
.sheet .st { font-family: "Songti SC", serif; font-size: 34rpx; font-weight: 600; letter-spacing: 1rpx; }
.sheet .ss { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; line-height: 1.7; }
.sheet-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 24rpx; }
.sheet-actions .btn { justify-content: flex-start; border-radius: 18rpx; background: #F8F4EA; color: var(--ink); font-weight: 500; padding: 22rpx 24rpx; }
.sheet-actions .btn.primary { background: var(--red); color: #fff; }

/* 多行印章与标题 */
.hero .stamp,
.hero .h2,
.workbench .stamp {
  white-space: pre-line;
}
