# ============================================================
# 翰墨学堂 · Git 忽略规则
# 原则：只提交源码、配置模板、文档与演示素材；
#       依赖、构建产物、本地数据库、日志、真实上传文件、密钥一律不入库。
# ============================================================

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
target/
*.class
*.jar
*.war

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# ---------- 本地数据库（H2 文件库）----------
server/data/
*.mv.db
*.trace.db
*.lock.db

# ---------- 运行时日志 ----------
logs/
*.log
*.pid

# ---------- 运行时上传目录 ----------
# 例外：保留演示图片，保证克隆后示例数据能正常显示
server/uploads/*
!server/uploads/demo/
!server/uploads/demo/*

# ---------- 环境变量与密钥 ----------
.env
.env.*
!deploy/env/*.example

# ---------- 临时文件 ----------
.tmp_*
*.tmp
*.bak

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- AI 助手工作目录（不随代码入库）----------
# WorkBuddy / Claude Code / Cursor / Aider 等工具产生的会话记忆与本地清单
.workbuddy/
.wbapp_*.genie
*.genie
.claude/
CLAUDE.md
.cursor/
.aider*
.continue/

